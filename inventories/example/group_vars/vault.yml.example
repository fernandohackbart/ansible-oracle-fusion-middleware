---
# Copy this file to group_vars/<environment>/vault.yml and encrypt it:
#
#   ansible-vault encrypt group_vars/prod/vault.yml
#
# Never commit a plaintext vault file. The values below are placeholders only.
#
# External secret manager example (requires an additional collection):
#   ofmAdminPassword: "{{ lookup('community.hashi_vault.vault_kv2_get', 'ofm/admin', field='password') }}"
#
# See docs/secrets.md for the full workflow.
ofmAdminPassword: "CHANGE_ME"
ofmNodemanagerPassword: "CHANGE_ME"
ofmJdbcRCUPassword: "CHANGE_ME"
ofmJdbcsysPassword: "CHANGE_ME"
ofmJDBCPassword: "CHANGE_ME"
